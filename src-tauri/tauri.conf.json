{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceNote Lab",
  "version": "0.2.0",
  "identifier": "de.mindriclab.voicenotelab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceNote Lab",
        "label": "main",
        "width": 600,
        "height": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "minWidth": 200,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": null
  },
  "bundle": {
    "publisher": "mindric lab",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:voicenote-lab.db"]
    }
  }
}
